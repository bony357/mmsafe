---
import Base from '../../layouts/Base.astro';
import '../../styles/admin.css';
const apiUrl = (import.meta.env.PUBLIC_ADMIN_API_URL ?? '').replace(/\/$/, '');
const siteUrl = import.meta.env.BASE_URL;
---
<Base
  title="Panel promocji – MMSafe"
  description="Panel administracyjny"
  noindex
  icons={['add', 'arrow_downward', 'arrow_upward', 'close', 'delete', 'edit', 'logout', 'upload']}
>
  <div class="admin" id="admin" data-api={apiUrl} data-site={siteUrl}>
    <header class="bar">
      <a href={siteUrl} class="brand">MMSafe <span>· panel promocji</span></a>
      <button type="button" class="link" id="logout" hidden><span class="ms" aria-hidden="true">logout</span>Wyloguj</button>
    </header>

    <!-- Logowanie -->
    <section class="panel login" id="login-view" hidden>
      <h1>Zaloguj się</h1>
      <p class="muted">Panel do edycji karuzeli „Aktualne promocje” na stronie.</p>
      <form id="login-form">
        <label>Hasło<input type="password" name="password" autocomplete="current-password" required autofocus></label>
        <button type="submit" class="btn primary">Zaloguj</button>
        <p class="error" id="login-error" role="alert"></p>
      </form>
    </section>

    <!-- Lista promocji -->
    <section class="panel" id="list-view" hidden>
      <div class="list-head">
        <div>
          <h1>Promocje w karuzeli</h1>
          <p class="muted">Kolejność na liście = kolejność na stronie. Zmiany trafią na stronę dopiero po kliknięciu „Zapisz i opublikuj”.</p>
        </div>
        <button type="button" class="btn" id="add"><span class="ms" aria-hidden="true">add</span>Dodaj promocję</button>
      </div>
      <ol class="slides" id="slides"></ol>
      <p class="empty muted" id="empty" hidden>Brak promocji – sekcja „Oferta sezonowa” nie będzie widoczna na stronie.</p>
    </section>

    <p class="panel muted" id="config-error" hidden>Panel nie jest skonfigurowany (brak adresu API – zmienna <code>PUBLIC_ADMIN_API_URL</code>).</p>
    <p class="panel muted" id="loading">Wczytywanie…</p>

    <!-- Pasek zapisu -->
    <div class="savebar" id="savebar" hidden>
      <span id="save-status" role="status"></span>
      <button type="button" class="btn ghost" id="discard">Cofnij zmiany</button>
      <button type="button" class="btn primary" id="save">Zapisz i opublikuj</button>
    </div>

    <!-- Edycja promocji -->
    <dialog id="editor" aria-labelledby="editor-title">
      <form id="editor-form" method="dialog">
        <div class="dlg-head">
          <h2 id="editor-title">Edytuj promocję</h2>
          <button type="button" class="icon-btn" id="editor-close" aria-label="Zamknij"><span class="ms" aria-hidden="true">close</span></button>
        </div>
        <div class="field image-field">
          <span class="label">Zdjęcie</span>
          <div class="image-pick">
            <img id="editor-preview" alt="" hidden>
            <label class="btn"><span class="ms" aria-hidden="true">upload</span><span id="image-btn-text">Wybierz zdjęcie</span>
              <input type="file" id="editor-file" accept="image/jpeg,image/png,image/webp" hidden>
            </label>
          </div>
          <small class="muted">JPG, PNG lub WebP. Na stronie zdjęcie wyświetla się jako kwadrat – najlepiej w proporcjach 1:1 (min. 1000×1000 px); inne zostaną przycięte do środka.</small>
        </div>
        <div class="grid2">
          <label class="field">Etykieta<input name="tag" maxlength="40" required placeholder="np. Samochód"></label>
          <label class="field">Plakietka promocji<input name="promo" maxlength="40" required placeholder="np. −10% z kodem agenta"></label>
        </div>
        <label class="field">Tytuł<input name="title" maxlength="120" required></label>
        <label class="field">Opis<textarea name="text" rows="4" maxlength="600" required></textarea></label>
        <label class="field">Zalety (każda w nowej linii)<textarea name="points" rows="4" placeholder="Pomoc drogowa 24/7&#10;Samochód zastępczy"></textarea></label>
        <div class="grid2">
          <label class="field">Tekst przycisku<input name="cta" maxlength="40" required placeholder="np. Sprawdź ofertę"></label>
          <label class="field">Link przycisku<input name="link" maxlength="500" required placeholder="https://…"></label>
        </div>
        <p class="error" id="editor-error" role="alert"></p>
        <div class="dlg-foot">
          <button type="button" class="btn ghost" id="editor-cancel">Anuluj</button>
          <button type="submit" class="btn primary" value="ok">Zatwierdź</button>
        </div>
      </form>
    </dialog>
  </div>

  <script>
    import { initAdmin } from '../../scripts/admin';
    initAdmin(document.getElementById('admin')!);
  </script>
</Base>
