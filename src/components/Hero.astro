---
import { Image } from 'astro:assets';
import hero from '../assets/hero.webp';
import { company } from '../data/site';
---
<section id="top" class="hero">
  <div class="ring ring-1" aria-hidden="true"></div>
  <div class="ring ring-2" aria-hidden="true"></div>
  <div class="inner">
    <div class="copy">
      <div class="eyebrow">Multiagencja ubezpieczeniowa · Śląsk</div>
      <h1>Spokój, który można <span>ubezpieczyć</span></h1>
      <p class="lead">Porównuję oferty ponad 40 towarzystw i dobieram polisę do Twoich potrzeb - samochód, dom, życie, podróże i firma. <br>Bez szukania na własną rękę, bez drobnego druku.</p>
      <div class="actions">
        <a href="#kontakt" class="btn-primary">Bezpłatna wycena<span class="ms" aria-hidden="true">arrow_forward</span></a>
        <a href="#oferta" class="btn-outline">Zobacz ofertę</a>
      </div>
      <div class="rating"><span class="stars">★★★★★ 5.0</span>/ średnia ocen z Google</div>
    </div>
    <div class="visual">
      <div class="frame" aria-hidden="true"></div>
      <div class="photo">
        <Image src={hero} alt="MMSafe Ubezpieczenia – Małgorzata Migas, doradca ubezpieczeniowy w Imielinie" widths={[560, 800, 1048]} sizes="(min-width: 1200px) 548px, (min-width: 760px) 45vw, 92vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="badge">
        <span class="ms" aria-hidden="true">location_on</span>
        <div><strong>{company.street}, {company.city}</strong><span>Zapraszam do biura</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero{position:relative;background:#fdfcf9;overflow:hidden}
  .ring{position:absolute;border-radius:50%}
  .ring-1{right:-160px;top:-160px;width:520px;height:520px;border:1px solid rgba(184,145,63,.35)}
  .ring-2{right:-110px;top:-110px;width:420px;height:420px;border:1px solid rgba(184,145,63,.2)}
  .inner{position:relative;max-width:1200px;margin:0 auto;padding:80px 24px 96px;display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:56px;align-items:center}
  .copy{display:flex;flex-direction:column;gap:24px}
  h1{margin:0;font-family:'Playfair Display',serif;font-weight:600;font-size:clamp(38px,5vw,60px);line-height:1.08;color:#26244f;text-wrap:balance}
  h1 span{color:#a8843f;font-style:italic}
  .lead{margin:0;font-size:18px;line-height:1.6;color:#55536e;max-width:500px;text-wrap:pretty}
  .actions{display:flex;gap:14px;flex-wrap:wrap;padding-top:8px}
  .btn-primary{background:#26244f;color:#fff;padding:16px 28px;font-weight:600;font-size:15px;border-radius:2px;display:flex;align-items:center;gap:10px}
  .btn-primary:hover{background:#35327a;color:#fff}
  .btn-primary .ms{font-size:20px}
  .btn-outline{border:1px solid #b8913f;color:#26244f;padding:16px 28px;font-weight:600;font-size:15px;border-radius:2px}
  .btn-outline:hover{background:#fff;color:#26244f}
  .rating{display:flex;gap:10px;align-items:center;color:#55536e;font-size:14px;padding-top:6px}
  .stars{color:#b8913f;letter-spacing:2px}
  .visual{position:relative;padding:0 24px 24px 0}
  .frame{position:absolute;right:0;bottom:0;left:24px;top:24px;border:1px solid #b8913f}
  .photo{position:relative;width:100%;aspect-ratio:5/4;background:#f1eee6;box-shadow:0 30px 60px -30px rgba(38,36,79,.45);overflow:hidden}
  .photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:33.8% 50%}
  .badge{position:absolute;left:-12px;bottom:48px;background:#fff;padding:16px 20px;display:flex;gap:12px;align-items:center;box-shadow:0 14px 34px -14px rgba(38,36,79,.35);border-left:2px solid #b8913f}
  .badge .ms{font-size:26px;color:#a8843f}
  .badge div{display:flex;flex-direction:column;gap:2px}
  .badge strong{font-size:14px;color:#26244f}
  .badge div span{font-size:13px;color:#6b6985}
</style>
